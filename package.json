{
  "name": "dijkstra-snake",
  "version": "0.1.0",
  "description": "3D Snake game with A* pathfinding AI, built with Three.js",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cypress:open": "cypress open --config viewportWidth=1920,viewportHeight=1080",
    "cypress:run": "cypress run --config viewportWidth=1920,viewportHeight=1080",
    "cypress:run:headed": "cypress run --headed --config viewportWidth=1920,viewportHeight=1080",
    "test:e2e": "start-server-and-test dev http://localhost:5173 cypress:run",
    "test:e2e:headed": "start-server-and-test dev http://localhost:5173 cypress:run:headed",
    "tail:watch": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/tailwind.output.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericbowser/Dijkstra_Snake.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ericbowser/Dijkstra_Snake/issues"
  },
  "homepage": "https://github.com/ericbowser/Dijkstra_Snake#readme",
  "dependencies": {
    "three": "^0.165.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "cypress": "^15.20.0",
    "postcss": "^8.4.0",
    "start-server-and-test": "^2.0.0",
    "tailwindcss": "^3.4.0",
    "vite": "^8.2.0"
  }
}
